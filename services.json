{
  "gateway": {
    "title": "本地服务网关",
    "subtitle": "一键跳转到本机已启动的前端服务",
    "port": 5200,
    "startScript": "run_wsl.sh",
    "bash": ""
  },
  "services": [
    {
      "id": "note",
      "name": "Note TipTap",
      "description": "笔记应用前端（Vite dev server），后端接口在 10101。",
      "port": 5202,
      "envPort": "NOTE_PORT",
      "startArgs": ["note"],
      "color": "#6ea8fe",
      "tags": ["Note", "Vite"]
    },
    {
      "id": "seekfile",
      "name": "SeekFile",
      "description": "本地文件检索服务页面。",
      "port": 9993,
      "envPort": "SEEKFILE_PORT",
      "startArgs": ["seekfile"],
      "color": "#5fd7a6",
      "tags": ["SeekFile"]
    },
    {
      "id": "pi-wsl",
      "name": "PI (WSL)",
      "description": "PI 前端，WSL 侧。",
      "port": 5210,
      "envPort": "PI_PORT_WSL",
      "color": "#a78bfa",
      "tags": ["PI", "WSL"]
    },
    {
      "id": "dsh-wsl",
      "name": "DSH (WSL)",
      "description": "DSH 前端，WSL 侧。",
      "port": 5211,
      "envPort": "DSH_PORT_WSL",
      "color": "#f0a868",
      "tags": ["DSH", "WSL"]
    },
    {
      "id": "pi",
      "name": "PI",
      "description": "PI 前端，Windows 侧。",
      "port": 5212,
      "envPort": "PI_PORT",
      "color": "#7dd3fc",
      "tags": ["PI"]
    },
    {
      "id": "dsh",
      "name": "DSH",
      "description": "DSH 前端，Windows 侧。",
      "port": 5213,
      "envPort": "DSH_PORT",
      "color": "#f472b6",
      "tags": ["DSH"]
    }
  ]
}
